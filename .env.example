# Copy to .env and fill in. Never commit .env.

# Client — Vite inlines these into the browser bundle. Public by design;
# the anon key is only safe because row-level security is enforced server-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fixture-backed demo mode: every read and write resolves from an in-memory
# store instead of Supabase, and a role picker signs you in without a password.
# Unset = on under `pnpm dev`, off in a production build. Set to `false` once
# migrations 002-006 are applied and you want to develop against real data.
VITE_DEMO_MODE=

# Server — read only by serverless functions under api/.
SUPABASE_URL=
# server-only — never prefix with VITE_, Vite inlines VITE_* into the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# Payment gateway (Midtrans Snap), read only by api/webhooks/payment.ts.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=
