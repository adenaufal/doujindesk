# Copy to .env and fill in. Never commit .env.

# Client — Vite inlines these into the browser bundle. Public by design;
# the anon key is only safe because row-level security is enforced server-side.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server — read only by serverless functions under api/.
SUPABASE_URL=
# server-only — never prefix with VITE_, Vite inlines VITE_* into the client bundle
SUPABASE_SERVICE_ROLE_KEY=
